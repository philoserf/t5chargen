# Generated fixtures. These are the engine's own output, compared byte for
# byte by the golden tests (chargen/testdata/*.json is json.MarshalIndent,
# render/testdata/*.md is the renderer's Markdown). Reformatting them makes
# the tests fail and, worse, would let a formatter rather than the engine
# decide what a character record looks like.
chargen/testdata/
render/testdata/

# The compatibility corpus. Each record is the byte-for-byte output of the
# released binary that wrote it (docs/COMPATIBILITY.md), so a formatter
# touching one destroys the only thing it is evidence of: what that
# version actually produced.
audit/testdata/corpus/

# Showboat document. Every fenced block is re-executed and diffed against
# its captured output by `uvx showboat verify`, so reformatting the file
# breaks the verification it exists to provide.
walkthrough.md

# Local scratch. `.issues` is ignored globally (~/.gitignore), so these are
# working notes rather than source; formatting them only makes `task` fail
# on files the repo does not carry.
.issues/
